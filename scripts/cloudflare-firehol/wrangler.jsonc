{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firehol-commit-monitor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/30 * * * *"] },
  "kv_namespaces": [
    { "binding": "STATE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true }
}
